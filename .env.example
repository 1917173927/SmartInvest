# OpenAI-compatible research and optional embedding endpoints
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
STOCK_ANALYSIS_MODEL=
STOCK_ANALYSIS_EMBEDDING_MODEL=
# 可选：向量服务可与 DeepSeek 对话服务分开；不配置则使用 OPENAI_BASE_URL/API_KEY
STOCK_ANALYSIS_EMBEDDING_BASE_URL=
STOCK_ANALYSIS_EMBEDDING_API_KEY=
# Gemini 原生嵌入接口（可与 DeepSeek 对话 API 同时使用）
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Optional Hugging Face settings. HTTP is often more reliable than Xet on personal networks.
HF_HUB_DISABLE_XET=1
HF_TOKEN=

# SEC requests require a descriptive user agent with contact information.
SEC_USER_AGENT=PersonalStockAnalysis your-email@example.com

# Optional override; defaults to the current working directory.
STOCK_ANALYSIS_HOME=
